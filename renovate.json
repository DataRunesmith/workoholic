{
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Stockholm",
  "platformCommit": "enabled",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge non-major updates once all required checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance"],
      "automerge": true
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  }
}
