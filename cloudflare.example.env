# Every __NAME__ placeholder used in the source is listed here. Copy this file,
# fill in your own values and render a deployable copy with:
#   node tools/render.mjs my-values.env build
# Secrets (ADMIN_PASSWORD, SMTP_PASSWORD, ...) do not belong here.
PUBLIC_HOST=app.example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
D1_DATABASE_NAME=workoholic
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
SECRETS_STORE_ID=00000000000000000000000000000000
CONFIG_NAMESPACE=Workoholic
SITE_FAMILY=Example
THEME_KEY_PREFIX=workoholic
THEME_COOKIE_DOMAIN=
