# Copy to setup.env (git-ignored) and fill in. Only the first two lines are required.
# The token is temporary: create it with the link in the README, run `pnpm setup`,
# then delete the token in the Cloudflare dashboard.
CLOUDFLARE_API_TOKEN=
PUBLIC_HOST=app.example.com

# Optional. AUTH=password (default) generates a login password for you.
# AUTH=access needs the two values below (Cloudflare Access).
AUTH=password
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional. Only needed if the token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=
